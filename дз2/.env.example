# Скопируйте в .env и впишите личный ключ. Ключ выдаёт преподаватель, у каждого
# свой, с лимитом взвешенных токенов. Не публикуйте его и не кладите в репозиторий.
LLM_BASE_URL=https://claude.gigaparsers.ru
LLM_API_KEY=
# Модель курса. В часы пиковой нагрузки шлюз отвечает по ней 503 с пояснением;
# тогда клиент повторит запрос и сообщит текст ответа, замер запустите позже.
LLM_MODEL=deepseek-flash
# Лимит запросов в минуту на ключ
LLM_RPM=10
# Как передавать ключ: x-api-key (по умолчанию) или bearer, если так требует шлюз.
LLM_AUTH_SCHEME=x-api-key
# Добавка к телу каждого запроса. По умолчанию рассуждение выключено: deepseek-flash
# думает без спроса, и при коротком max_tokens весь ответ уходит в рассуждение.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# Веса взвешенных токенов, в них шлюз считает лимит: вход ×1, выход ×1,
# чтение из кэша ×0,1, запись в кэш ×1,25.
LLM_WEIGHT_OUT=1
LLM_WEIGHT_CACHE=0.1
LLM_WEIGHT_CACHE_WRITE=1.25
# Цены в условных единицах за миллион токенов: вход и выход.
LLM_PRICE_IN=0.20
LLM_PRICE_OUT=0.80
